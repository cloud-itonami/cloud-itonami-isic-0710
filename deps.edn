{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/robotics"}
        ;; Cross-actor supply-chain-linkage contract (ADR-2607999950,
        ;; extended by ADR-2607999960/ADR-2607999970): `ironops.export/
        ;; pedigree-for-production-record` packages a `kotoba.pedigree`
        ;; record from a real, on-file production record (an ore-grade
        ;; survey + tonnage this actor already recorded via `ironops.
        ;; store/add-production-record`) so a downstream actor (`cloud-
        ;; itonami-isic-2410`) can independently re-verify the claim as
        ;; plain EDN data -- never a live network call between actors.
        ;; This actor is the ORIGIN of the ADR-2607999950 pedigree
        ;; chain (never embeds an `:upstream` of its own), so it does
        ;; not strictly need the `:pedigree/upstream` chaining support
        ;; ADR-2607999960 added -- pinned to the CURRENT HEAD anyway
        ;; (the same SHA `cloud-itonami-isic-2930`/`cloud-itonami-
        ;; isic-2910` already pin) for fleet-wide pin consistency, not
        ;; because this repo's own code path needs it. A real pinned
        ;; git-coordinate dep (not :local/root), same reasoning
        ;; `steelworks.robotics`'s physics-2d dependency and every
        ;; other cross-org dependency in this fleet already
        ;; establishes, so this repo stays forkable standalone outside
        ;; the monorepo.
        io.github.kotoba-lang/pedigree
        {:git/url "https://github.com/kotoba-lang/pedigree.git"
         :sha "f85784211422a651fea26f448f601abfba2e7d61"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain + DADS to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/jp-go-digital-design-system
         {:local/root "../../kotoba-lang/jp-go-digital-design-system"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "ironops.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave1 A-hand).
  :render-html {:main-opts ["-m" "ironops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; ADR-2607999970's own cross-repo-test alias. THIS REPO IS THE
  ;; ORIGIN of the ADR-2607999950 pedigree chain -- it has no upstream
  ;; sibling repo of its own to cross into, so this alias's :extra-deps
  ;; needs no foreign :local/root entry today (unlike `cloud-itonami-
  ;; isic-2930`'s own :cross-repo-test alias, which DOES declare
  ;; `cloud-itonami-isic-2410` as a sibling because isic-2930 has a
  ;; real upstream to call into). It exists for two reasons: (1) so
  ;; this repo carries the SAME :cross-repo-test/test-cross-repo
  ;; directory-shape convention every other link in this chain already
  ;; uses, ready for `cloud-itonami-isic-2410` (ADR-2607999970 Part 2)
  ;; to declare THIS repo as ITS OWN :local/root sibling in ITS OWN
  ;; :cross-repo-test alias -- which requires no special export
  ;; ceremony on THIS side beyond the ordinary deps.edn/:paths shape
  ;; above (the same way `cloud-itonami-isic-2930` required nothing
  ;; extra of its own deps.edn for `cloud-itonami-isic-2910` to declare
  ;; it as a sibling, ADR-2607999960); (2) to house a real integration
  ;; test proving the SAME 'real data, not a fixture' discipline this
  ;; fleet requires for cross-actor claims -- a genuinely-stored
  ;; production record round-tripped through this actor's own real
  ;; store, never a hand-typed pedigree literal.
  :cross-repo-test
  {:extra-paths ["test-cross-repo"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-cross-repo"]
   :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test" "test-cross-repo"
                        "--fail-level" "error"]}}}
